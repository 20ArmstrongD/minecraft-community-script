# Minecraft Java management configuration, example only.
# Literal key=value data: never source this file.
# Full-line comments only; no quotes, export, expansion or inline comments.
# Example pins target vanilla 1.21.1, not the latest version. Choose deliberately.


# vanilla or fabric. Versions are exact; snapshots/latest are unsupported.
loader=vanilla

# REQUIRED: choose an exact release from the official Minecraft version list.
minecraft_version=1.21.1

# Fabric only: both loader and installer must be explicitly pinned; blank for vanilla.
fabric_loader_version=
fabric_installer_version=

# MiB. Leave at least 1 GiB of container RAM above heap_max_mb; 2 GiB is recommended.
heap_min_mb=2048
heap_max_mb=6144

# Game TCP listening port; the shared Playit tunnel DESTINATION must match.
port=25565

# Fixed directory name. No world switching/reset command is provided.
world_name=world

# Numeric OR text seed, taken literally; blank=random. Set BEFORE the FIRST start.
seed=
max_players=10
difficulty=normal
game_mode=survival

# true recommended. After startup: minecraft console "whitelist add PLAYER".
whitelist=true

# Literal spaces, punctuation and Unicode accepted. No quotes/escape syntax needed.
motd=Minecraft Community Server
view_distance=10
simulation_distance=6

# Number of successful manual/scheduled archives retained. Pre-change backups never prune.
backup_retention=14
backup_enabled=true

# systemd OnCalendar, guest local time. Applied only by minecraft config apply.
backup_calendar=*-*-* 05:00:00

# Read https://www.minecraft.net/eula; unattended setup additionally requires --accept-eula.
eula=false

# Optional actual Playit hostname/IP:public_TCP_port; may differ from the listening port.
public_endpoint=

# Description of existing agent machine plus LAN/VPN relationship. No secrets.
agent_location=

# IPv4 assigned to this Minecraft guest, reachable FROM the existing agent. Never remote localhost.
tunnel_destination_ip=
tunnel_destination_port=25565
